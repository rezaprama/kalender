{
  "name": "@rezaprama/kalender",
  "version": "1.0.0",
  "description": "Indonesian calendar, sourced public holidays, open API and embeddable calendar. 1900-2100.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "author": "Reza Prama Arviandi <https://rezaprama.com>",
  "repository": "https://github.com/rezaprama/kalender",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/client && tsc --noEmit -p tests/e2e",
    "lint": "biome lint src scripts tests",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run build && npm run typecheck && npm run lint && npm test",
    "preview": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run check && wrangler deploy",
    "cf:types": "wrangler types",
    "monitor": "tsx scripts/monitor.ts",
    "audit": "tsx scripts/audit.ts",
    "e2e": "tsx --test --test-concurrency=1 tests/e2e/*.e2e.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@phosphor-icons/core": "^2.1.1",
    "@types/node": "^24.0.0",
    "axe-core": "^4.14.0",
    "esbuild": "^0.25.0",
    "lighthouse": "^13.0.0",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.151.3"
  }
}
