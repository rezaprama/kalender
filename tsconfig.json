{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "@cloudflare/workers-types"
    ],
    "lib": [
      "ES2023"
    ]
  },
  "include": [
    "src",
    "scripts",
    "tests",
    "worker-configuration.d.ts"
  ],
  "exclude": [
    "src/client"
  ]
}
