{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kalender",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "account_id": "8c6e301847c1759dfb870b149faa05be",
  "workers_dev": true,
  "routes": [{ "pattern": "kalender.rezaprama.com", "custom_domain": true }],
  // Static files in dist/ are served without invoking the Worker; only unmatched
  // paths (HTML pages, /api/*, /embed) reach it. No run_worker_first needed:
  // dist/ contains no HTML, so page routes never collide with assets.
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  // Cloudflare's Git preview trigger uses `wrangler preview`. Assets stay above;
  // this Worker has no production state or secrets to copy into previews.
  "previews": {},
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
